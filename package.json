{
  "name": "@gnolang/ledger-ts",
  "version": "0.1.0",
  "description": "TypeScript client for the gno.land Ledger app (ledger-app-gno): USB transport and APDU protocol",
  "contributors": [
    "Alex M.<alex.megalokonomos@tendermint.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gnolang/ledger-ts.git"
  },
  "keywords": [
    "ledger",
    "hardware-wallet",
    "apdu",
    "tm2",
    "tendermint2",
    "gno",
    "gnoland"
  ],
  "files": [
    "dist/",
    "*.md",
    "!*.test.*"
  ],
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web.d.mts",
        "default": "./dist/web.mjs"
      },
      "require": {
        "types": "./dist/web.d.cts",
        "default": "./dist/web.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "build": "tsc --noEmit && tsdown",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "prepare": "pnpm build",
    "prepublishOnly": "pnpm lint",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "Alex M.<alex.megalokonomos@tendermint.com>",
  "license": "Apache-2.0",
  "homepage": "https://gno.land/",
  "packageManager": "pnpm@12.4.2",
  "dependencies": {
    "@ledgerhq/hw-transport": "^6.36.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@ledgerhq/hw-transport-node-hid": "^6.33.5",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@ledgerhq/hw-transport-webusb": "^6.35.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-istanbul": "^5.0.4",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "tsdown": "^0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "peerDependencies": {
    "@ledgerhq/hw-transport-node-hid": "^6.33.5",
    "@ledgerhq/hw-transport-webhid": "^6.36.0",
    "@ledgerhq/hw-transport-webusb": "^6.35.0"
  },
  "peerDependenciesMeta": {
    "@ledgerhq/hw-transport-node-hid": {
      "optional": true
    },
    "@ledgerhq/hw-transport-webhid": {
      "optional": true
    },
    "@ledgerhq/hw-transport-webusb": {
      "optional": true
    }
  }
}
